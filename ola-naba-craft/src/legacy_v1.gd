# Imports a starter (v1) save into the v2 format without touching the v1 file.
# The v1 world was a 35x35 island generated by the starter's GridMap code; that code is reproduced
# exactly here, the island is placed at the same x/z (36 blocks higher, above the v2 sea), and only
# the cells that differ from the new world's own terrain are stored as edits.
extends RefCounted

const B := preload("res://src/blocks.gd")
const Gen := preload("res://src/world_gen.gd")
const RADIUS := 17
const Y_SHIFT := 36
const V1_TO_V2 := [B.MOSS, B.SOIL, B.SLATE, B.TIMBER, B.CANOPY, B.PLANKS, B.GLOWGLASS]
const V1_ITEMS := ["moss", "soil", "slate", "timber", "canopy", "planks", "glowglass"]
const DAY_LENGTH := 600.0

# Same checks the starter's read_save() used. Returns {} when it is not a usable v1 save.
static func read_v1(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not parsed is Dictionary or int(parsed.get("version", -1)) != 1:
		return {}
	if not parsed.get("players") is Array or not parsed.get("edits") is Dictionary:
		return {}
	if parsed.players.size() != (2 if parsed.get("duo", false) else 1):
		return {}
	for record in parsed.players:
		if not record is Dictionary:
			return {}
	return parsed

# Reproduces the starter's make_world() + restore() as {Vector3i: v1 block or -1}.
static func v1_cells(seed_value: int, v1_edits: Dictionary) -> Dictionary:
	var cells := {}
	var noise := FastNoiseLite.new()
	noise.seed = seed_value
	noise.frequency = 0.095
	for x in range(-RADIUS, RADIUS + 1):
		for z in range(-RADIUS, RADIUS + 1):
			var h := roundi(noise.get_noise_2d(x, z) * 5.0)
			if absi(x) < 3 and absi(z) < 3:
				h = 0
			for y in range(-4, h + 1):
				cells[Vector3i(x, y, z)] = 0 if y == h else (1 if y >= h - 2 else 2)
			if (absi(x) > 4 or absi(z) > 4) and (x * 13 + z * 29 + seed_value) % 47 == 0:
				var base := Vector3i(x, h + 1, z)
				for y in range(3):
					cells[base + Vector3i(0, y, 0)] = 3
				for dx in range(-1, 2):
					for dz in range(-1, 2):
						cells[base + Vector3i(dx, 3, dz)] = 4
				cells[base + Vector3i(0, 4, 0)] = 4
	for key in v1_edits:
		var xyz := String(key).split(",")
		if xyz.size() == 3 and xyz[0].is_valid_int() and xyz[1].is_valid_int() and xyz[2].is_valid_int():
			var cell := Vector3i(int(xyz[0]), int(xyz[1]), int(xyz[2]))
			var kind := int(v1_edits[key])
			if absi(cell.x) > RADIUS or absi(cell.z) > RADIUS or cell.y <= -4 or cell.y > 24 or kind < -1 or kind > 6:
				continue
			cells[cell] = kind
	return cells

# Builds a complete v2 world dictionary (without id/name) from a v1 save.
static func convert(v1: Dictionary) -> Dictionary:
	var seed_value := int(v1.get("seed", 40521))
	var cells := v1_cells(seed_value, v1.get("edits", {}))
	var gen := Gen.new(seed_value)
	var generated := {}   # chunk key -> PackedByteArray
	var edits := {}       # chunk key -> {local index: block}
	for x in range(-RADIUS, RADIUS + 1):
		for z in range(-RADIUS, RADIUS + 1):
			var ck := Vector2i(floori(float(x) / Gen.CS), floori(float(z) / Gen.CS))
			if not generated.has(ck):
				generated[ck] = gen.generate(ck.x, ck.y)
			var data: PackedByteArray = generated[ck]
			for vy in range(-4, 25):
				var y := vy + Y_SHIFT
				var want := B.AIR
				var v = cells.get(Vector3i(x, vy, z), -1)
				if int(v) >= 0:
					want = V1_TO_V2[int(v)]
				var idx := (posmod(x, Gen.CS) * Gen.CS + posmod(z, Gen.CS)) * Gen.H + y
				if data[idx] != want:
					if not edits.has(ck):
						edits[ck] = {}
					edits[ck][idx] = want
			# a slate foundation under the island down to the new world's ground
			var col := (posmod(x, Gen.CS) * Gen.CS + posmod(z, Gen.CS)) * Gen.H
			for y in range(Y_SHIFT - 5, 1, -1):
				var id := data[col + y]
				if B.SOLID[id] and id != B.CANOPY and id != B.BLOSSOM:
					break
				if not edits.has(ck):
					edits[ck] = {}
				edits[ck][col + y] = B.SLATE
	var profiles := ["ola", "naba"]
	var players := {}
	var duo := bool(v1.get("duo", false))
	var solo := clampi(int(v1.get("solo_skin", 0)), 0, 1)
	for i in v1.players.size():
		var rec: Dictionary = v1.players[i]
		var who: String = profiles[i if duo else solo]
		var pos: Array = rec.get("position", [0, 2, 0.5])
		var inv := []
		var counts: Array = rec.get("inventory", [])
		for k in mini(counts.size(), V1_ITEMS.size()):
			var n := maxi(0, int(counts[k]))
			while n > 0:
				inv.append({"id": V1_ITEMS[k], "n": mini(n, 64)})
				n -= 64
		players[who] = {"avatar": who,
			"position": [float(pos[0]) if pos.size() == 3 else 0.0, (float(pos[1]) if pos.size() == 3 else 2.0) + Y_SHIFT, float(pos[2]) if pos.size() == 3 else 0.5],
			"yaw": float(rec.get("yaw", 0.0)), "pitch": float(rec.get("pitch", -0.12)),
			"health": clampi(int(rec.get("hp", 5)) * 4, 4, 20), "food": clampi(int(rec.get("stamina", 5)) * 4, 0, 20),
			("creative_inventory" if v1.get("creative", false) else "inventory"): inv}
	return {"seed": seed_value, "rules": "creative" if v1.get("creative", false) else "survival",
		"time": fposmod(float(v1.get("day_time", 35.0)), 220.0) / 220.0 * DAY_LENGTH,
		"session": {"split": duo, "stacked": bool(v1.get("stacked", false)), "solo_avatar": profiles[solo]},
		"edits": edits, "players": players, "spawn": [0.5, Y_SHIFT + 2.0, 0.5]}
